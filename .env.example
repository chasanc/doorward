# Reference for every setting. `node scripts/write-local-env.mjs` writes the
# real, gitignored files: .env, apps/api/.env and apps/web/.env.
# Set your own JWT_SECRET and GRPC_API_KEY before exposing the service.

# --- .env (shared) ---
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
MULTI_COMPANY_MODE=false

# --- apps/api/.env ---
HTTP_HOST=0.0.0.0
HTTP_PORT=3001
GRPC_PORT=5581
GRPC_TLS=false
GRPC_TLS_CA=../../deploy/certs/server/ca.crt
GRPC_TLS_CERT=../../deploy/certs/server/server.crt
GRPC_TLS_KEY=../../deploy/certs/server/server.key
GRPC_TLS_REQUIRE_CLIENT_CERT=false
GRPC_API_KEY=
DATABASE_KIND=postgres
DATABASE_URL=postgresql://doorward:doorward@localhost:5432/doorward
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# OpenID Connect (single sign-on). Off while OIDC_ISSUER is empty.
OIDC_ISSUER=https://doorward.example.com/oidc
OIDC_COOKIE_KEYS=
OIDC_SIGNING_KEY_PATH=./oidc-signing-key.json
TOTP_ENCRYPTION_KEY=

# LDAP sign-in.
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=
LDAP_USER_FILTER=(uid={username})
LDAP_COMPANY_KEY=
LDAP_GROUP_MAP=

# --- apps/web/.env ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api
API_INTERNAL_URL=http://localhost:3001/api
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEFAULT_APP_NAME=Doorward
NEXT_PUBLIC_MULTI_COMPANY_MODE=false
NEXT_PUBLIC_HOME_TITLE=Doorward

# Optional log switches (default true). Errors and warnings are always logged.
# LOG_HTTP_REQUESTS=true
# LOG_STARTUP=true
# LOG_AUTH_FAILURES=true

# Optional tracing (off unless an endpoint is set). Needs an OTLP/HTTP collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=doorward-api

